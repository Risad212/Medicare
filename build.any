
load("//anybuild/tools:laravel.bzl", "laravel_build", "laravel_config", "laravel_serve")

config = laravel_config(
    schema = 1,
    php_version = "8.4",
    phpix = True,
    php_framework = "laravel",
    composer_enable = True,
    composer_build_script = "",
    php_public_dir = "public",
)

build = laravel_build(config)

laravel_serve(
    config,
    build,
    name = "medicare",
    commands = {
        "start": "php -S 0.0.0.0:8080 -t public",
       "after_deploy": "php artisan config:clear && php artisan migrate --force --no-interaction",
    },
    volumes = [
        volume("medicare-uploads", "/app/storage/app/public"),
    ],
)
